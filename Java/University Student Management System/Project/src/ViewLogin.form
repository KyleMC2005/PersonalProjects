<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="src.ViewLogin">
  <grid id="27dc6" binding="panelMain" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1562" height="917"/>
    </constraints>
    <properties>
      <background color="-14988955"/>
      <enabled value="true"/>
      <maximumSize width="1920" height="1080"/>
      <minimumSize width="600" height="400"/>
      <preferredSize width="1280" height="720"/>
    </properties>
    <border type="empty" title="Welcome, Please Sign In" title-justification="2" title-position="2">
      <font name="Calibri" size="48"/>
      <title-color color="-3479041"/>
      <size top="220" left="280" bottom="150" right="280"/>
    </border>
    <children>
      <grid id="ba7d8" binding="panelSub" layout-manager="GridLayoutManager" row-count="6" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="9">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-10508077"/>
          <maximumSize width="1920" height="1080"/>
        </properties>
        <border type="empty">
          <size top="50" left="60" bottom="60" right="70"/>
        </border>
        <children>
          <component id="934cb" class="javax.swing.JTextField" binding="idField">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="4" vsize-policy="5" hsize-policy="7" anchor="8" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-3479041"/>
              <font size="22"/>
              <name value=""/>
              <text value=""/>
              <toolTipText value="ID"/>
            </properties>
          </component>
          <component id="19082" class="javax.swing.JPasswordField" binding="passwordField">
            <constraints>
              <grid row="2" column="1" row-span="2" col-span="4" vsize-policy="7" hsize-policy="7" anchor="8" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <background color="-3479041"/>
              <font size="22"/>
              <toolTipText value="Password"/>
            </properties>
          </component>
          <component id="6d444" class="javax.swing.JLabel" binding="person">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="72" height="72"/>
              </grid>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16448250"/>
              <icon value="imageIcons/testPerson.png"/>
              <iconTextGap value="20"/>
              <text value="User Email:"/>
            </properties>
          </component>
          <component id="9329c" class="javax.swing.JButton" binding="signInButton">
            <constraints>
              <grid row="5" column="2" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="280" height="80"/>
              </grid>
            </constraints>
            <properties>
              <background color="-3479041"/>
              <focusTraversalPolicyProvider value="true"/>
              <font name="Calibri" size="32"/>
              <foreground color="-16448250"/>
              <text value="Sign In"/>
            </properties>
          </component>
          <component id="45df1" class="javax.swing.JButton" binding="createAccButton">
            <constraints>
              <grid row="5" column="4" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="280" height="80"/>
              </grid>
            </constraints>
            <properties>
              <background color="-3479041"/>
              <focusTraversalPolicyProvider value="true"/>
              <font name="Calibri" size="32"/>
              <foreground color="-16448250"/>
              <label value="Create New Account"/>
              <text value="Create New Account"/>
            </properties>
          </component>
          <component id="9e5f8" class="javax.swing.JLabel" binding="lock">
            <constraints>
              <grid row="2" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="72" height="72"/>
              </grid>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16448250"/>
              <icon value="imageIcons/resizedLock.png"/>
              <text value="Password:"/>
            </properties>
          </component>
          <component id="3ceec" class="javax.swing.JButton" binding="forgotButton">
            <constraints>
              <grid row="4" column="4" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-10508077"/>
              <borderPainted value="false"/>
              <font name="Calibri" size="26"/>
              <foreground color="-16448250"/>
              <text value="Forgot password?"/>
            </properties>
          </component>
          <component id="bb380" class="javax.swing.JLabel" binding="role">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="72" height="72"/>
              </grid>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16777216"/>
              <icon value="imageIcons/resizedStudentCap.png"/>
              <iconTextGap value="15"/>
              <text value="Select a Role:"/>
            </properties>
          </component>
          <component id="7c94a" class="javax.swing.JRadioButton" binding="studentRadioButton" default-binding="true">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <alignmentY value="0.0"/>
              <background color="-10508077"/>
              <font name="Calibri" size="22"/>
              <selected value="true"/>
              <text value="Student"/>
            </properties>
          </component>
          <component id="8b86d" class="javax.swing.JRadioButton" binding="lecturerRadioButton" default-binding="true">
            <constraints>
              <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <alignmentY value="0.0"/>
              <background color="-10508077"/>
              <font name="Calibri" size="22"/>
              <text value="Lecturer"/>
            </properties>
          </component>
          <component id="b337f" class="javax.swing.JRadioButton" binding="managerRadioButton">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="2" use-parent-layout="false"/>
            </constraints>
            <properties>
              <alignmentY value="0.0"/>
              <background color="-10508077"/>
              <font name="Calibri" size="22"/>
              <label value="Manager"/>
              <text value="Manager"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
  <buttonGroups>
    <group name="roleSelect">
      <member id="7c94a"/>
      <member id="8b86d"/>
      <member id="b337f"/>
    </group>
  </buttonGroups>
</form>
