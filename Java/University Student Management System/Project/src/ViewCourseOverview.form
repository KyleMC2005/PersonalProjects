<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="src.ViewCourseOverview">
  <grid id="27dc6" binding="panelMain" layout-manager="GridLayoutManager" row-count="2" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="30" left="40" bottom="40" right="20"/>
    <constraints>
      <xy x="20" y="20" width="875" height="623"/>
    </constraints>
    <properties>
      <background color="-14988955"/>
      <foreground color="-3479041"/>
      <maximumSize width="1920" height="1080"/>
      <minimumSize width="600" height="400"/>
      <preferredSize width="1280" height="720"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="8e79a" class="javax.swing.JLabel" binding="courseTitle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Calibri" size="36"/>
          <foreground color="-3479041"/>
          <text value="Course Overview"/>
        </properties>
      </component>
      <grid id="5e632" binding="panelResults" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="0" bottom="20" right="0"/>
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="2" use-parent-layout="false">
            <preferred-size width="500" height="-1"/>
            <maximum-size width="500" height="-1"/>
          </grid>
        </constraints>
        <properties>
          <background color="-4265496"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="84491" class="javax.swing.JLabel" binding="noResultsLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Calibri" size="28"/>
              <foreground color="-16777216"/>
              <text value="&lt;html&gt;No Results &lt;br&gt; Available&lt;/HTML&gt;"/>
            </properties>
          </component>
          <component id="2474b" class="javax.swing.JLabel" binding="starIcon">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <icon value="imageIcons/star.png"/>
              <text value=""/>
            </properties>
          </component>
          <component id="75764" class="javax.swing.JLabel" binding="resultsLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Calibri" size="50"/>
              <foreground color="-16777216"/>
              <text value="Results"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="1f722" binding="panelModuleList" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-10508077"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="5435e" class="javax.swing.JLabel" binding="modulesLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Calibri" size="50"/>
              <foreground color="-16777216"/>
              <text value="Modules:"/>
            </properties>
          </component>
          <vspacer id="48f42">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
        </children>
      </grid>
      <component id="16b51" class="javax.swing.JButton" binding="backButton1">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="6" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-14988955"/>
          <borderPainted value="false"/>
          <focusTraversalPolicyProvider value="true"/>
          <horizontalAlignment value="2"/>
          <horizontalTextPosition value="2"/>
          <icon value="imageIcons/resizedHome.png"/>
          <text value=""/>
        </properties>
      </component>
      <component id="7b7d6" class="javax.swing.JButton" binding="logOutButton" default-binding="true">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-3479041"/>
          <font name="Calibri" size="18"/>
          <foreground color="-16448250"/>
          <text value="Log Out"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
