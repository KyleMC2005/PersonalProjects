<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="src.ViewListModuleStudents">
  <grid id="27dc6" binding="panelMain" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1070" height="805"/>
    </constraints>
    <properties>
      <background color="-14988955"/>
      <preferredSize width="1280" height="720"/>
    </properties>
    <border type="empty">
      <size top="50" left="50" bottom="50" right="50"/>
    </border>
    <children>
      <grid id="df84d" binding="panelHeader" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14988955"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="b414f" class="javax.swing.JButton" binding="homeButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-14988955"/>
              <focusPainted value="false"/>
              <foreground color="-14988955"/>
              <icon value="imageIcons/resizedHome.png"/>
              <label value=""/>
              <text value=""/>
            </properties>
          </component>
          <component id="8c011" class="javax.swing.JLabel" binding="titleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Calibri" size="50"/>
              <foreground color="-3479041"/>
              <text value="View Module Students"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="41a56" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="20" bottom="20" right="150"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-14988955"/>
          <enabled value="true"/>
        </properties>
        <border type="none">
          <size top="20" left="20" bottom="20" right="20"/>
        </border>
        <children>
          <hspacer id="d9704">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <grid id="22514" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="1" fill="0" indent="0" use-parent-layout="false">
                <minimum-size width="500" height="500"/>
              </grid>
            </constraints>
            <properties>
              <background color="-15920"/>
              <font name="Calibri" size="12"/>
              <foreground color="-15920"/>
            </properties>
            <border type="none" title="List of Students" title-justification="2">
              <font size="22"/>
              <title-color color="-16777216"/>
            </border>
            <children>
              <hspacer id="eb5a5">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
