<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="src.ViewForgetPassword">
  <grid id="27dc6" binding="panelMain" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1302" height="877"/>
    </constraints>
    <properties>
      <background color="-14988955"/>
      <maximumSize width="1920" height="1080"/>
      <minimumSize width="600" height="400"/>
      <preferredSize width="1280" height="720"/>
    </properties>
    <border type="empty" title="Forgot Password?" title-justification="2" title-position="2">
      <font name="Calibri" size="48"/>
      <title-color color="-3479041"/>
      <size top="220" left="280" bottom="150" right="280"/>
    </border>
    <children>
      <grid id="2e5ad" binding="panelSub" layout-manager="GridLayoutManager" row-count="4" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="9">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties>
          <background color="-10508077"/>
          <maximumSize width="1920" height="1080"/>
        </properties>
        <border type="empty">
          <size top="25" left="60" bottom="60" right="70"/>
        </border>
        <children>
          <component id="88cf" class="javax.swing.JTextField" binding="emailField">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="4" vsize-policy="5" hsize-policy="7" anchor="0" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <font size="26"/>
              <name value=""/>
              <text value=""/>
              <toolTipText value="ID"/>
            </properties>
          </component>
          <component id="fd9f8" class="javax.swing.JPasswordField" binding="newPassword">
            <constraints>
              <grid row="1" column="2" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="8" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <font size="26"/>
              <toolTipText value="Password"/>
            </properties>
          </component>
          <component id="f715d" class="javax.swing.JLabel" binding="email">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="72" height="72"/>
              </grid>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16448250"/>
              <horizontalAlignment value="10"/>
              <horizontalTextPosition value="11"/>
              <icon value="imageIcons/resizedEmail.png"/>
              <iconTextGap value="93"/>
              <text value="Email:"/>
              <verticalAlignment value="0"/>
              <verticalTextPosition value="0"/>
            </properties>
          </component>
          <component id="cdac1" class="javax.swing.JButton" binding="submitButton">
            <constraints>
              <grid row="3" column="4" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="4" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="20"/>
              </grid>
            </constraints>
            <properties>
              <background color="-3479041"/>
              <font name="Calibri" size="32"/>
              <foreground color="-16448250"/>
              <label value="Submit"/>
              <text value="Submit"/>
            </properties>
          </component>
          <component id="4bde5" class="javax.swing.JLabel" binding="lock1">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="72" height="72"/>
              </grid>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16448250"/>
              <icon value="imageIcons/resizedLock.png"/>
              <iconTextGap value="25"/>
              <text value="New Password:"/>
            </properties>
          </component>
          <component id="30312" class="javax.swing.JPasswordField" binding="confirmPassword">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="8" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <font size="26"/>
              <foreground color="-16448250"/>
              <toolTipText value="Password"/>
            </properties>
          </component>
          <component id="b78f6" class="javax.swing.JLabel" binding="lock2">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Calibri" size="18"/>
              <foreground color="-16448250"/>
              <icon value="imageIcons/resizedLock.png"/>
              <iconTextGap value="0"/>
              <text value="Confirm Password:"/>
            </properties>
          </component>
          <component id="15ad" class="javax.swing.JButton" binding="backButton1">
            <constraints>
              <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-10508077"/>
              <borderPainted value="false"/>
              <horizontalAlignment value="2"/>
              <horizontalTextPosition value="2"/>
              <icon value="imageIcons/smallerBackArrow.png"/>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
